# ======================================================================
# Studio Réseaux — configuration du serveur (copier en .env)
# ======================================================================

# Obligatoire ----------------------------------------------------------
SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
ANTHROPIC_API_KEY=
# Adresse publique HTTPS de l'appli (indispensable pour Instagram/Facebook)
PUBLIC_BASE_URL=https://studio.exemple.fr
TIMEZONE=Europe/Paris

# Claude ----------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Sous-titres : taille du modèle de transcription (tiny, base, small, medium)
WHISPER_MODEL=small

# Notifications « c'est l'heure de poster » (webhook Slack, Teams, Google Chat…)
NOTIFY_WEBHOOK_URL=

# Connecteurs (laisser vide = publication assistée) ----------------------
# Meta : jeton longue durée d'un utilisateur administrateur de la Page
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# LinkedIn : urn:li:person:xxx (profil) ou urn:li:organization:xxx (page)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202509

# X : jeton OAuth 2.0 utilisateur (tweet.write, media.write)
X_USER_ACCESS_TOKEN=

# Taille max. des fichiers envoyés (Mo)
MAX_UPLOAD_MB=1024
